---
import { getDocsForNavByCategory } from "@/utils/content";


const { pathname } = Astro.url;

const NAV_LINKS = {
  basic: {
    label: 'Getting Started',
    links: await getDocsForNavByCategory('getting_started')
  },
  components: {
    label: 'Components',
    links: await getDocsForNavByCategory('components')
  }
};
---

<div class="uk-padding">
  <h2 class="uk-h6 uk-text-uppercase uk-heading-divider">{NAV_LINKS.basic.label}</h2>
  <ul class="uk-nav uk-nav-default">
    {
      NAV_LINKS.basic.links.map(({ label, slug }) => (
        <li class={pathname.slice(1) === slug ? 'uk-active' : ''}>
          <a href={`/${slug}`}>{label}</a>
        </li>
      ))
    }
  </ul>

  <h2 class="uk-h6 uk-text-uppercase uk-heading-divider">{NAV_LINKS.components.label}</h2>
  <ul class="uk-nav uk-nav-default">
    {
      NAV_LINKS.components.links.map(({ label, slug }) => (
        <li class={pathname.slice(1) === slug ? 'uk-active' : ''}>
          <a href={`/${slug}`}>{label}</a>
        </li>
      ))
    }
  </ul>
</div>
