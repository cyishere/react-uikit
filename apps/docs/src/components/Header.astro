---
const { pathname } = Astro.url;

const NAV_LINKS = [
	{
		label: 'Docs',
		slug: '',
	},
	{
		label: 'Components',
		slug: 'accordion',
	}
]
---

<nav class="uk-background-primary uk-light">
	<div class="uk-container uk-container-expand">
		<div class="uk-navbar">
			<div class="uik-navbar-left">
				<button type="button" class="menu-button" aria-label="Open navigation" aria-expanded="false">Menu</button>

				<a class="uk-navbar-item uk-logo" href="/" aria-label="Back to Home">react-uikit</a>
			</div>

			<div class="uk-navbar-right">
				<div class="uk-navbar-item">
					<button class="uk-button uk-button-default">Search</button>
				</div>
				<ul class="uk-navbar-nav">
					{NAV_LINKS.map(({ label, slug }) => (
						<li class={pathname.slice(1) === slug ? 'uk-active' : ''}>
							<a href={`/${slug}`}>Docs</a>
						</li>
					))}
					<li>
						<a href="https://github.com/cyishere/react-uikit" target="_blank" rel="noopener noreferrer">GitHub</a>
					</li>
				</ul>
			</div>
		</nav>
	</div>
</header>


<style>
	.menu-button {
		display: none;
	}

	@media (max-width: 768px) {
		.menu-button {
			display: block;
		}
}
</style>