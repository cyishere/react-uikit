---
interface Props {
  headings: { depth: number; slug: string; text: string }[];
}
const { headings = [] } = Astro.props as Props;

const tocItems = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

<aside class="uk-padding toc" aria-label="Page Contents">
  <h2 class="uk-h6 uk-text-muted uk-text-uppercase">On This Page</h2>
  {
    tocItems.length > 0 && (
      <nav>
        <ul class="toc-list">
          {tocItems.map((item) => (
            <li class={`toc-item toc-depth-${item.depth}`}>
              <a href={`#${item.slug}`}>{item.text}</a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }
</aside>

<style lang="scss">
  .toc {
    width: 196px;
    flex-shrink: 0;
    position: sticky;
    top: 0;
    overflow-y: auto;
  }

  @media (max-width: 1100px) {
    .toc {
      display: none;
    }
  }
</style>

<script>
  const tocLinks = document.querySelectorAll('.toc-item');

  function updateActiveToc() {
    if (!tocLinks.length) return;

    const lastIndex = tocLinks.length - 1;

    if (lastIndex > 0) {
      const prevLink = tocLinks[lastIndex - 1].querySelector('a');
      const lastLink = tocLinks[lastIndex].querySelector('a');
      const prevHref = prevLink?.getAttribute('href');
      const lastHref = lastLink?.getAttribute('href');
      const prevId = prevHref?.slice(1);
      const lastId = lastHref?.slice(1);
      const prevHeading = prevId ? document.getElementById(prevId) : null;
      const lastHeading = lastId ? document.getElementById(lastId) : null;

      if (prevHeading && lastHeading) {
        const prevRect = prevHeading.getBoundingClientRect();
        const lastRect = lastHeading.getBoundingClientRect();

        if (prevRect.bottom < 0 && lastRect.bottom > 85) {
          tocLinks[lastIndex].classList.add('active');
          for (let j = 0; j < lastIndex; j++) {
            tocLinks[j].classList.remove('active');
          }
          return;
        }
      }
    }

    let currentIndex = 0;

    for (let i = 0; i < tocLinks.length; i++) {
      const link = tocLinks[i].querySelector('a');

      if (!link) continue;

      const href = link.getAttribute('href');

      if (!href) continue;

      const id = href.slice(1);
      const heading = document.getElementById(id);

      if (heading) {
        const rect = heading.getBoundingClientRect();

        if (rect.top <= 85) {
          currentIndex = i;
        }
      }
    }

    for (let j = 0; j < tocLinks.length; j++) {
      tocLinks[j].classList.toggle('active', j === currentIndex);
    }
  }

  let ticking = false;

  window.addEventListener('scroll', () => {
    if (!ticking) {
      requestAnimationFrame(() => {
        updateActiveToc();
        ticking = false;
      });
      ticking = true;
    }
  });

  document.addEventListener('DOMContentLoaded', updateActiveToc);

  setTimeout(updateActiveToc, 100);
</script>
