---
import { Nav } from './Nav';
---

<nav class="sidebar uk-background-muted uk-padding-small">
	<Nav />	
</nav>

<style>
	.sidebar {
		width: 228px;
		flex-shrink: 0;
		overflow-y: auto;
		transition: transform .25s cubic-bezier(.4,0,.2,1);
		z-index: 200;
	}

	@media (max-width: 768px) {
		.sidebar {
			display: none;
		}
	}
</style>