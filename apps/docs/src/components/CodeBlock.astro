---
import CopyButton from '@/components/CopyButton';

const props = Astro.props;
const id = `code-${crypto.randomUUID()}`;
---

<div class="wrapper uk-margin">
  <div class="uk-flex uk-flex-between uk-flex-middle uk-text-muted uk-text-uppercase controlls">
    <span>{props['data-language']}</span>
    <CopyButton targetId={id} client:load />
  </div>
  {
    props.notInMDX ? <div id={id}><slot /></div> : (
<pre {...props} id={id}><slot /></pre>
    )
  }
</div>

<style lang="scss">
  @import 'uikit/src/scss/variables.scss';

  .wrapper {
    border: 1px solid $global-border;
  }

  .controlls {
    padding: 0.25rem 0.5rem;
    border-bottom: 1px solid $global-border;
  }

  :global(.astro-code) {
    --astro-code-p: 1rem;
    
    width: calc(100% - var(--astro-code-p) * 2);
    padding: var(--astro-code-p);
    border: none;
    margin: 0;
  }
</style>
