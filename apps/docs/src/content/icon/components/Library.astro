---
import type { IconCategory } from '@cyishere/react-uikit';
import { getIconsByCategory, Icon } from '@cyishere/react-uikit';

const grouped = getIconsByCategory();

// Render in UIkit's heading order; only categories that have icons show up
const CATEGORY_LABELS: Record<IconCategory, string> = {
  app: 'App',
  devices: 'Devices',
  storage: 'Storage',
  direction: 'Direction',
  editor: 'Editor',
  brands: 'Brands'
};
const order: IconCategory[] = ['app', 'devices', 'storage', 'direction', 'editor', 'brands'];
---

{
  order
    .filter((cat) => grouped[cat]?.length)
    .map((cat) => (
      <>
        <h4 class="uk-heading-line">
          <span>{CATEGORY_LABELS[cat]}</span>
        </h4>
        <ul class="uk-list grid">
          {grouped[cat]?.map((name) => (
            <li>
              <Icon name={name} label={name} client:visible /> {name}
            </li>
          ))}
        </ul>
      </>
    ))
}

<style>
  :global(.grid) {
    --layout-grid-min: 30%;
  }

  li {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
</style>
