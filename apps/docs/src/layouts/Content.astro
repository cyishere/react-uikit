---
import BaseLayout from '@/layouts/Base.astro';
import { marked } from 'marked';

const { title, tagline, description, headings } = Astro.props;
---

<BaseLayout headings={headings}>
  <div class="uk-section">
    <h1>{title}</h1>
    {tagline && <p class="uk-text-lead uk-text-muted">{tagline}</p>}
    {description && <p set:html={marked.parseInline(description)} />}
    <hr />

    <div class="uk-article">
      <slot />
    </div>
  </div>
</BaseLayout>

