---
import BaseLayout from '@/layouts/Base.astro';
import { marked } from 'marked';
import { Icon } from 'react-uikit';

const { title, tagline, description, headings, prev, next } = Astro.props;
---

<BaseLayout headings={headings}>
  <div class="uk-section">
    <h1>{title}</h1>
    {tagline && <p class="uk-text-lead uk-text-muted">{tagline}</p>}
    {description && <p set:html={marked.parseInline(description)} />}
    <hr />

    <div class="uk-article uk-padding uk-padding-remove-horizontal">
      <slot />
    </div>

    <hr class="uk-hr" />

    <div class="uk-margin uk-flex uk-flex-between uk-padding-large uk-padding-remove-horizontal">
      <div>
        {prev && <a href={`/${prev.slug}`} class="uk-flex uk-flex-left uk-flex-middle uk-text-emphasis">
          <Icon name="chevron-left" client:load />
          <div class="uk-flex uk-flex-column uk-margin-small-left">
            <span class="uk-text-muted uk-text-uppercase">Prev</span>
            <span>{prev.label}</span>
          </div>
        </a>}
      </div>
      <div>
        {next && <a href={`/${next.slug}`} class="uk-flex uk-flex-right uk-flex-middle uk-text-emphasis">
          <div class="uk-flex uk-flex-column uk-flex-bottom uk-margin-small-right">
            <span class="uk-text-muted uk-text-uppercase">Next</span>
            <span>{next.label}</span>
          </div>
          <Icon name="chevron-right" client:load />
        </a>}
      </div>
    </div>
  </div>
</BaseLayout>

