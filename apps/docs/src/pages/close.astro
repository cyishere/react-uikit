---
import ContentLayout from '@/layouts/Content.astro';
import { Content, frontmatter, components } from '@/content/close.mdx'
import { customComponents } from '@/components/CustomComponents.astro'

const { title, description } = frontmatter;
---

<ContentLayout title={title} description={description}>
	<Content components={{...components, ...customComponents }} />
</ContentLayout>
