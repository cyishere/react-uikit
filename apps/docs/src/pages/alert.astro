---
import BaseLayout from '@/layouts/Base.astro';
import { Content, frontmatter, components } from '@/content/alert.mdx'
import CodeBlock from '@/components/CodeBlock.astro'

const { title, description } = frontmatter;
---

<BaseLayout>
	<div class="uk-section">
		<h1>{title}</h1>
		<p class="uk-text-lead uk-text-muted">{description}</p>
		<hr>

		<div class="uk-article">
			<Content components={{...components, pre: CodeBlock }} />
		</div>
	</div>
</BaseLayout>
