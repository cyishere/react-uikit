---
import BaseLayout from '@/layouts/Base.astro';
import { Content, frontmatter } from '@/components/demos/Alert/alert.mdx'

const { title, description } = frontmatter;
---

<BaseLayout>
	<div class="uk-section">
		<h1>{title}</h1>
		<p class="uk-text-lead">{description}</p>
		<hr>

		<Content />
	</div>
</BaseLayout>
