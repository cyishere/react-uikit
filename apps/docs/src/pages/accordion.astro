---
import ContentLayout from '@/layouts/Content.astro';
import { Content, frontmatter, components } from '@/content/accordion.mdx';
import { customComponents } from '@/components/CustomComponents.astro';

const { title, tagline, description } = frontmatter;
---

<ContentLayout title={title} tagline={tagline} description={description}>
  <Content components={{ ...components, ...customComponents }} />
</ContentLayout>
