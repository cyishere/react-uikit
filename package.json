{
  "name": "react-uikit-workspace",
  "version": "1.0.0",
  "type": "module",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "pnpm --filter react-uikit build",
    "dev:lib": "pnpm --filter react-uikit dev",
    "dev:docs": "pnpm --filter docs dev",
    "dev": "concurrently \"pnpm dev:lib\" \"pnpm dev:docs\"",
    "test": "pnpm --filter react-uikit test",
    "test:run": "pnpm --filter react-uikit test:run",
    "format": "prettier --write --experimental-cli .",
    "type-check": "pnpm --filter react-uikit type-check",
    "lint": "pnpm format && eslint .",
    "lint:fix": "eslint . --fix",
    "docs:check": "pnpm --filter docs check",
    "check": "pnpm lint && pnpm docs:check && pnpm type-check"
  },
  "keywords": [],
  "author": "Chen Yang",
  "license": "ISC",
  "packageManager": "pnpm@10.11.1",
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "astro-eslint-parser": "^1.4.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "globals": "^17.4.0",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.2"
  }
}
